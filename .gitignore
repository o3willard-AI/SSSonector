# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Build directory
build/

# Dependency directories
vendor/

# IDE specific files
.idea/
.vscode/
*.swp
*.swo

# OS specific files
.DS_Store
Thumbs.db

# Distribution artifacts
dist/

# Certificate files
certs/
*.crt
*.key

# Log files
logs/
*.log

# Release artifacts
release.json
go*.tar.gz

# Compiled binaries and object files (never commit build output; anchored
# to the repository root so source directories like cmd/tunnel are tracked)
/sssonector
/sssonectorctl
/tunnel
/tunnel_client
/main
*.o

# Local QA deploy snapshots
qa_deploy_*/

# Third-party audit/defect reports stay out of the public tree (workspace root)
/AUDIT-REPORT.md
/DOCS-AUDIT-REPORT.md
/*-AUDIT-REPORT.md
