# SSSonector Server Instance Template
# Variables: {{INSTANCE_NAME}}, {{TUN_INTERFACE}}, {{TUN_ADDRESS}}, {{LISTEN_PORT}}
type: server
config:
  mode: server
  logging:
    level: info
    file: /var/log/sssonector/{{INSTANCE_NAME}}.log
    format: json
  network:
    name: {{TUN_INTERFACE}}
    interface: {{TUN_INTERFACE}}
    mtu: 1500
    address: {{TUN_ADDRESS}}
  tunnel:
    listen_address: 0.0.0.0
    listen_port: {{LISTEN_PORT}}
  auth:
    cert_file: /etc/sssonector/instances/{{INSTANCE_NAME}}/certs/server.crt
    key_file: /etc/sssonector/instances/{{INSTANCE_NAME}}/certs/server.key
    ca_file: /etc/sssonector/instances/{{INSTANCE_NAME}}/certs/ca.crt
  security:
    tls:
      min_version: "1.2"
      max_version: "1.3"
    auth_method: certificate
    cert_rotation:
      enabled: false
  monitor:
    enabled: true
    type: prometheus
    interval: 10s
    prometheus:
      enabled: true
      port: {{PROMETHEUS_PORT}}
      listen_address: "127.0.0.1" # restrict exposure; use a mgmt IP if scrapers are remote
      path: /metrics
  metrics:
    enabled: true
    interval: 5s
    buffer_size: 1000
  # HTTPS Facade for firewall traversal
  facade:
    enabled: false
    listen_address: 0.0.0.0
    listen_port: 443
    token_secret: ""         # REQUIRED when facade enabled: shared HMAC secret (high-entropy, must match client)
    token_ttl: 30s
    tls:
      cert_file: ""
      key_file: ""
      ca_file: ""
    tunnel_ports:
      - {{LISTEN_PORT}}
throttle:
  enabled: true
  rate: {{RATE_LIMIT}}
  burst: {{RATE_BURST}}    # accepted but unused: burst is always 100ms of effective rate
metadata:
  schema_version: "2.0.0"
  version: 1.0.0
  environment: production
  region: local
  instance: {{INSTANCE_NAME}}
